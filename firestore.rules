rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A real staff account = signed in with email/password (NOT anonymous).
    function isStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /app/{doc} {
      // Staff (real logins): full access to all app data. The UI still gates
      // actions via can()/isSuperAdmin(); these rules just keep outsiders out.
      allow read, write: if isStaff();

      // Public coach-evaluation link (?feedback=1) signs in ANONYMOUSLY.
      // An anonymous user may ONLY:
      //   - read the questions config
      //   - read/write the feedback doc
      // and NOTHING else (no customers / users / backups / etc.).
      allow read:        if request.auth != null && doc == 'crm_config';
      allow read, write: if request.auth != null && doc == 'crm_feedback';
    }
  }
}
